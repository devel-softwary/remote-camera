PORT=3000
# PUBLIC_BASE_URL=https://camera.example.com

# Directory locale per le foto. Il percorso Docker predefinito viene montato su ./uploads.
# PHOTO_STORAGE_DIR=/percorso/assoluto/alle/foto

# Optional TURN server. Strongly recommended when devices are on different networks.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=password

# Optional direct HTTPS from Node. Usually better to terminate TLS in Caddy/Nginx.
# TLS_CERT=/run/secrets/fullchain.pem
# TLS_KEY=/run/secrets/privkey.pem
